{
  "name": "better-schema-markup",
  "version": "0.19.0",
  "description": "Schema.org JSON-LD for better SEO and rich results. Replaces the schema output of Yoast SEO and Rank Math, with WPGraphQL support.",
  "keywords": [],
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "Rick Centerhall",
    "url": "https://rickcenterhall.com/"
  },
  "type": "module",
  "scripts": {
    "start": "wp-env start",
    "stop": "wp-env stop",
    "wp": "wp-env run cli wp",
    "build": "vp build",
    "dev": "vp build --watch",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test && vp run test:php",
    "test:js": "vp test",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$PWD\") vendor/bin/phpunit",
    "composer": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$PWD\") composer",
    "package": "vp build && python3 bin/package.py",
    "i18n": "vp run wp i18n make-pot wp-content/plugins/schema-ld wp-content/plugins/schema-ld/languages/better-schema-markup.pot --domain=better-schema-markup --slug=better-schema-markup --exclude=node_modules,vendor,tests,src,dist,release-assets"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/core-data": "^8.2.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/editor": "^15.2.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/plugins": "^7.57.0",
    "@wordpress/url": "^4.57.0",
    "clsx": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "^1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  }
}
